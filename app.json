{
  "expo": {
    "name": "italiano",
    "slug": "italiano",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "italiano",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.marekberanek.italiano",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBF7EE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FBF7EE",
          "dark": {
            "backgroundColor": "#2A1A0F"
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#009246",
          "defaultChannel": "italiano-default",
          "enableBackgroundRemoteNotifications": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "translateEndpoint": "https://italiano-api.vercel.app/api/translate",
      "contentBaseUrl": "https://italiano-api.vercel.app",
      "supabaseUrl": "https://akxtiooloqgpksffermk.supabase.co",
      "supabaseAnonKey": "sb_publishable_6CZBK9q-0IFqYJ1rLPw1Hg_tOBZ6PBf",
      "displayName": "Italiano",
      "tagline": "Procvičuj italská slovíčka",
      "author": "Marek Beránek",
      "repositoryUrl": "https://github.com/marekberanek/italiano",
      "router": {},
      "eas": {
        "projectId": "cbb1f571-c3f5-49bc-b3b0-6b80478427fb"
      }
    },
    "owner": "marekberanek",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/cbb1f571-c3f5-49bc-b3b0-6b80478427fb"
    }
  }
}
