# This file is for the Expo/React Native app ONLY. Server-only secrets
# (DEEPL_API_KEY, SUPABASE_SERVICE_ROLE_KEY, ...) belong to backend/.env
# — see backend/.env.example.

# URL of your DeepL proxy. From a phone use your computer's LAN IP, not localhost.
# Local:    http://192.168.1.10:3000/api/translate
# Vercel:   https://italiano-api.vercel.app/api/translate
EXPO_PUBLIC_TRANSLATE_ENDPOINT=https://italiano-api.vercel.app/api/translate

# Optional: base URL of the backend serving lesson JSON (manifest + bundles).
# Without it the app uses the bundled JSON from assets/data/ + cache.
EXPO_PUBLIC_CONTENT_BASE_URL=https://italiano-api.vercel.app

# Supabase Auth + cloud vocab sync. Both values come from
# Supabase Dashboard → Project Settings → API.
# The anon key is safe to ship in the mobile app (RLS protects data).
EXPO_PUBLIC_SUPABASE_URL=https://akxtiooloqgpksffermk.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_6CZBK9q-0IFqYJ1rLPw1Hg_tOBZ6PBf

