# Zkopíruj do souboru `.env` v kořeni projektu (vedle package.json).
# URL backendu s DeepL proxy — musí být dosažitelná z telefonu/emulátoru (viz README).

EXPO_PUBLIC_TRANSLATE_ENDPOINT=

# Supabase (Auth + slovíčka přes RLS). Hodnoty z Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Volitelné: URL backendu s obsahem lekcí (manifest + JSON bundly). Bez hodnoty jede app jen z vestavěných JSON v repu a případné cache.
EXPO_PUBLIC_CONTENT_BASE_URL=

# --- Backend (Vercel) — pro /api/account/delete a /api/account/export ---
# Stejné jako v Supabase dashboardu; service role jen na serveru, nikdy v aplikaci.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
