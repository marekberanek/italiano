# Copy to `.env` next to package.json (ROOT of the repo).
# This file is for the Expo/React Native app ONLY. Server-only secrets
# (DEEPL_API_KEY, SUPABASE_SERVICE_ROLE_KEY, ...) belong to backend/.env
# — see backend/.env.example.

# URL of your DeepL proxy.
# - iOS Simulator / Android Emulator (host loopback): 127.0.0.1 (Android emulator: 10.0.2.2)
# - Physical phone:  use this Mac's current LAN IP (e.g. http://192.168.0.215:3000/api/translate)
#                    `ipconfig getifaddr en0` (Wi-Fi) prints it.
# - Vercel:          https://<your-project>.vercel.app/api/translate
EXPO_PUBLIC_TRANSLATE_ENDPOINT=

# Optional: base URL of the backend serving lesson JSON (manifest + bundles).
# Without it the app uses the bundled JSON from assets/data/ + cache.
EXPO_PUBLIC_CONTENT_BASE_URL=

# Supabase Auth + cloud vocab sync. Both values come from
# Supabase Dashboard → Project Settings → API.
# The anon key is safe to ship in the mobile app (RLS protects data).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
