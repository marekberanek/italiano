{
  "rules": [
    {
      "combo": "C + e/i",
      "pronunciation": "č",
      "example": "cena → čena"
    },
    {
      "combo": "C + a/o/u",
      "pronunciation": "k",
      "example": "casa → kaza"
    },
    {
      "combo": "CH",
      "pronunciation": "k",
      "example": "chiave → kjave"
    },
    {
      "combo": "G + e/i",
      "pronunciation": "dž",
      "example": "giro → džiro"
    },
    {
      "combo": "GN",
      "pronunciation": "ň",
      "example": "gnocchi → ňoki"
    },
    {
      "combo": "GLI",
      "pronunciation": "lj",
      "example": "figlio → filjo"
    },
    {
      "combo": "SC + e/i",
      "pronunciation": "š",
      "example": "scena → šena"
    },
    {
      "combo": "Z",
      "pronunciation": "ts/dz",
      "example": "pizza → picca"
    },
    {
      "combo": "H",
      "pronunciation": "němé",
      "example": "ho → o"
    }
  ]
}
