  "sections": [
    {
      "title": "Kolik je hodin?",
      "subtitle": "Nejčastější otázka a odpověď",
      "items": [
        {
          "it": "Che ore sono?",
          "cz": "Kolik je hodin?",
          "p": "[ke ore sono?]"
        },
        {
          "it": "Sono le tre.",
          "cz": "Jsou tři (hodiny).",
          "p": "[sono le tre.]"
        },
        {
          "it": "È l'una.",
          "cz": "Je jedna hodina.",
          "p": "[é l'una.]"
        },
        {
          "it": "Sono le due e un quarto.",
          "cz": "Jsou čtvrt na tři.",
          "p": "[sono le due e un kvarto.]"
        },
        {
          "it": "Sono le tre e mezza.",
          "cz": "Jsou půl čtvrté.",
          "p": "[sono le tre e mecca.]"
        },
        {
          "it": "Sono le quattro meno un quarto.",
          "cz": "Je čtvrt na čtyři.",
          "p": "[sono le kvattro meno un kvarto.]"
        },
        {
          "it": "Sono le cinque in punto.",
          "cz": "Je přesně pět.",
          "p": "[sono le činkve in punto.]"
        }
      ]
    },
    {
      "title": "Poledne a půlnoc",
      "items": [
        {
          "it": "È mezzogiorno.",
          "cz": "Je poledne.",
          "p": "[é meccodžorno.]"
        },
        {
          "it": "È mezzanotte.",
          "cz": "Je půlnoc.",
          "p": "[é meccanotte.]"
        },
        {
          "it": "A mezzogiorno mangiamo.",
          "cz": "V poledne obědváme.",
          "p": "[a meccodžorno mandžamo.]"
        },
        {
          "it": "Torno a mezzanotte.",
          "cz": "Vrátím se o půlnoci.",
          "p": "[torno a meccanotte.]"
        }
      ]
    },
    {
      "title": "24 hodin vs běžná mluva",
      "subtitle": "Úředně se často říká 13–24 h; v hovoru často dopoledne / odpoledne",
      "items": [
        {
          "it": "Sono le quindici.",
          "cz": "Je patnáct hodin (15:00) — formální styl.",
          "p": "[sono le kvindiči.]"
        },
        {
          "it": "Sono le tre del pomeriggio.",
          "cz": "Jsou tři odpoledne (15:00) — srozumitelné v řeči.",
          "p": "[sono le tre del pomeridžo.]"
        },
        {
          "it": "Sono le ventidue.",
          "cz": "Je dvacet dva hodin (22:00).",
          "p": "[sono le ventidue.]"
        },
        {
          "it": "L'appuntamento è alle nove di sera.",
          "cz": "Schůzka je v devět večer.",
          "p": "[l'appuntamento é alle nove di sera.]"
        },
        {
          "it": "Partiamo alle otto di mattina.",
          "cz": "Vyrážíme v osm ráno.",
          "p": "[partjamo alle otto di mattina.]"
        }
      ]
    },
    {
      "title": "Části hodiny (stručně)",
      "items": [
        {
          "it": "e un quarto",
          "cz": "a čtvrt (za čtvrt hodiny po celé)",
          "p": "[e un kvarto]"
        },
        {
          "it": "e mezza",
          "cz": "a půl",
          "p": "[e mecca]"
        },
        {
          "it": "meno un quarto",
          "cz": "mínus čtvrt (do celé)",
          "p": "[meno un kvarto]"
        },
        {
          "it": "e dieci",
          "cz": "a deset (minut)",
          "p": "[e dječi]"
        }
