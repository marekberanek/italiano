      "title": "Datum (den v měsíci)",
      "items": [
        {
          "it": "Il primo maggio è festa.",
          "cz": "Prvního května je svátek.",
          "p": "[il primo madžo é festa.]"
        },
        {
          "it": "Il quindici aprile.",
          "cz": "Patnáctého dubna.",
          "p": "[il kvindiči aprile.]"
        },
        {
          "it": "Siamo il venti giugno.",
          "cz": "Je dvacátého června.",
          "p": "[sjamo il venti džuňo.]"
        }
      ]
    },
    {
      "title": "Patro a pořadí",
      "items": [
        {
          "it": "Abito al secondo piano.",
          "cz": "Bydlím ve druhém patře.",
          "p": "[abito al sekondo pjano.]"
        },
        {
          "it": "È la prima volta che vengo.",
          "cz": "Je to poprvé, co přicházím.",
          "p": "[é la prima volta ke vengo.]"
        },
        {
          "it": "Arrivo per secondo.",
          "cz": "Přijdu jako druhý / na druhém místě.",
          "p": "[arrivo per sekondo.]"
        }
      ]
