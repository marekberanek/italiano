# Copy to `backend/.env` (next to package.json IN backend/).
# Loaded by `vercel dev` for local development. Never commit real secrets.
# For the deployed backend, set the same variables in
# Vercel Dashboard → Project → Settings → Environment Variables.

# DeepL key for /api/translate. Free keys end with ":fx".
DEEPL_API_KEY=

# --- Supabase (server-only) ---
# Used by /api/account/delete and /api/account/export.
# SUPABASE_URL / SUPABASE_ANON_KEY have the same values as their
# EXPO_PUBLIC_* counterparts in the app .env. The service role key is
# DIFFERENT — it bypasses Row Level Security and must NEVER ship in the app.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: bumps the lesson content version returned by /api/content-manifest
# so clients re-pull bundles after content changes.
CONTENT_VERSION=2
