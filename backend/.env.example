# Copy to `backend/.env` (next to package.json IN backend/).
# Loaded by `vercel dev` for local development. Never commit real secrets.
# For the deployed backend, set the same variables in
# Vercel Dashboard → Project → Settings → Environment Variables.

# DeepL key for /api/translate. Free keys end with ":fx".
DEEPL_API_KEY=

# --- Supabase (server-only) ---
# SUPABASE_URL / SUPABASE_ANON_KEY have the same values as their
# EXPO_PUBLIC_* counterparts in the app .env. They are used by:
#   - /api/account/delete and /api/account/export (user JWT verification)
#   - /api/content-manifest and /api/content-bundle (read public.content_bundles)
# The service role key is DIFFERENT — it bypasses Row Level Security and must
# NEVER ship in the app. Used by `npm run content:push` to write bundles and
# by /api/account/delete to remove auth users.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: only used by `npm run db:migrate` (runs supabase/migrations/*.sql).
# In the dashboard open your project → green **Connect** (top) → Session pooler
# → copy URI. User must be `postgres.<project_ref>`, host `*.pooler.supabase.com`,
# port `5432`. (Old path *Settings → Database* was removed from the UI in 2025.)
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Optional: only used as a fallback by /api/content-manifest when the
# database has no rows yet (or is unreachable). Once `npm run content:push`
# has populated public.content_bundles, the manifest version comes from
# public.content_meta where key='version' instead of this env var.
CONTENT_VERSION=fallback
